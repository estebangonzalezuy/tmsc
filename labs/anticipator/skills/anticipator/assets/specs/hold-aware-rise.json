    },
    "x_css_linear": "linear(0, -0.0053, -0.0231, -0.0531, -0.0858, -0.1091, -0.1192, -0.1032, -0.0128, 0.1295, 0.2981, 0.4723, 0.6372, 0.7828, 0.9034, 0.9969, 1.0639, 1.1068, 1.1292, 1.1353, 1.1293, 1.115, 1.096, 1.075, 1.0543, 1.0354, 1.0191, 1.006, 0.9962, 0.9895, 0.9856, 0.9838, 0.9838, 0.9851, 0.9871, 0.9896, 0.9921, 0.9945, 0.9967, 0.9985, 0.9999, 1.0009, 1.0015, 1.0019, 1.002, 1.0019, 1.0017, 1.0014, 1)"
