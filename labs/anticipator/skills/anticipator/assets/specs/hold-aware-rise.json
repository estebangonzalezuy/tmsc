      "y_px": 24
    },
    "to": {
      "opacity": 1,
      "y_px": 0
    },
    "x_spring": {
      "stiffness": 260,
      "damping": 18,
      "mass": 1,
      "velocity": 0,
      "rest_delta": 0.001
    },
    "x_anticipation": {
      "duration_ms": 120,
      "amount": 0.12,
      "easing": "cubic-bezier(0.45, 0, 0.55, 1)"
    },
