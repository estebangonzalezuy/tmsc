{
  "name": "anticipator-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Anticipator: real springs + anticipation for text animation specs. An expansion of Pixel Point's animate-text.",
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "vite build --config app/vite.config.ts",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "fit:catalog": "node scripts/fit-catalog.mjs",
    "generate:skill": "node --no-warnings=ExperimentalWarning scripts/generate-skill.mjs",
    "check:skill": "node scripts/check-skill.mjs",
    "export": "node scripts/export-video.mjs",
    "test": "node core/spring.test.ts && node scripts/validate-catalog.mjs && node scripts/check-skill.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test:physics": "node core/spring.test.ts"
  },
  "dependencies": {
    "dialkit": "2.1.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  },
  "license": "MIT"
}
