{
  "name": "anticipator-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Anticipator: real springs + anticipation for text animation specs. An expansion of Pixel Point's animate-text.",
  "scripts": {
    "dev": "vite --config app/vite.config.js",
    "build": "vite build --config app/vite.config.js",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "fit:catalog": "node scripts/fit-catalog.mjs",
    "generate:skill": "node scripts/generate-skill.mjs",
    "check:skill": "node scripts/check-skill.mjs",
    "export": "node scripts/export-video.mjs",
    "test": "node scripts/validate-catalog.mjs && node scripts/check-skill.mjs"
  },
  "dependencies": {
    "dialkit": "2.1.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0"
  }
}
