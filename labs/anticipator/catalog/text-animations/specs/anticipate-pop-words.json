{
  "id": "anticipate-pop-words",
  "display_name": "Anticipate Pop Words",
  "description": "Each word squashes smaller first (anticipation), then pops on an underdamped spring.",
  "inspiration": "Cel animation's squash before the stretch, at title-card scale.",
  "target": "per-word",
  "signature_easing": "cubic-bezier(0.334, 0.325, 0, 1.465)",
  "enter": {
    "duration_ms": 1135,
    "stagger_ms": 95,
    "easing": "cubic-bezier(0.334, 0.325, 0, 1.465)",
    "from": {
      "opacity": 0,
      "scale": 0.7
    },
    "to": {
      "opacity": 1,
      "scale": 1
    },
    "x_spring": {
      "stiffness": 320,
      "damping": 14,
      "mass": 1,
      "velocity": 0,
      "rest_delta": 0.001
    },
    "x_anticipation": {
      "duration_ms": 140,
      "amount": 0.15,
      "easing": "cubic-bezier(0.45, 0, 0.55, 1)"
    },
    "x_opacity_duration_ms": 160,
    "x_hold_ms": 900,
    "x_hold_per_word_ms": 180,
    "x_fallback": {
      "fitted_from": "fcac5cfe",
      "rms_error": 0.1788,
      "max_error": 0.418,
      "spring_phase_ms": 1135
    }
  },
  "exit": {
    "duration_ms": 200,
    "stagger_ms": 80,
    "easing": "cubic-bezier(0.7, 0, 0.84, 0)",
    "from": {
      "opacity": 1,
      "scale": 1
    },
    "to": {
      "opacity": 0,
      "scale": 0.8
    }
  },
  "swap": {
    "mode": "crossfade",
    "overlap_ms": 0,
    "micro_delay_ms": 35
  },
  "usage_notes": "Per-word only; per-character at ζ 0.39 reads as jitter. Short phrases (2–5 words). Keep x_opacity_duration_ms short (≤ ~180ms) or the squash happens while the word is still invisible. Pixel Point's equivalent 'spring' is cubic-bezier(0.34, 1.56, 0.64, 1): one fake overshoot; the Lab shows it on the left.",
  "x_intent": "playful",
  "x_intent_notes": "ζ ≈ 0.39: a clear pop and a second ring.",
  "x_built_on": "pixel-point/animate-text"
}
