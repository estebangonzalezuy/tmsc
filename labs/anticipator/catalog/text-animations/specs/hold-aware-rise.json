{
  "id": "hold-aware-rise",
  "display_name": "Hold-Aware Rise",
  "description": "A firm per-word rise that declares how long the copy must stay up to be read before anything exits.",
  "inspiration": "Subtitles and lower thirds: animating in is easy; leaving it up long enough is the job.",
  "target": "per-word",
  "signature_easing": "cubic-bezier(0.357, -0.265, 0, 1.602)",
  "enter": {
    "duration_ms": 899,
    "stagger_ms": 60,
    "easing": "cubic-bezier(0.357, -0.265, 0, 1.602)",
    "from": {
      "opacity": 0,
      "y_px": 24
    },
    "to": {
      "opacity": 1,
      "y_px": 0
    },
    "x_spring": {
      "stiffness": 260,
      "damping": 18,
      "mass": 1,
      "velocity": 0,
      "rest_delta": 0.001
    },
    "x_anticipation": {
      "duration_ms": 120,
      "amount": 0.12,
      "easing": "cubic-bezier(0.45, 0, 0.55, 1)"
    },
    "x_opacity_duration_ms": 200,
    "x_hold_ms": 900,
    "x_hold_per_word_ms": 250,
    "x_fallback": {
      "fitted_from": "1bc4458e",
      "rms_error": 0.1059,
      "max_error": 0.1977,
      "spring_phase_ms": 899
    }
  },
  "exit": {
    "duration_ms": 320,
    "stagger_ms": 24,
    "easing": "cubic-bezier(0.7, 0, 0.84, 0)",
    "from": {
      "opacity": 1,
      "y_px": 0
    },
    "to": {
      "opacity": 0,
      "y_px": -12
    }
  },
  "swap": {
    "mode": "sequential",
    "overlap_ms": 0,
    "micro_delay_ms": 60
  },
  "usage_notes": "Hold = enter.x_hold_ms + words × enter.x_hold_per_word_ms, counted from the moment the last word settles. Never start the exit sooner to fit a loop: lengthen the loop. 250ms/word suits short display copy; 300+ for body-like lines.",
  "x_intent": "editorial",
  "x_intent_notes": "Same physics as spring-rise-letters, per word, plus a reading contract.",
  "x_built_on": "pixel-point/animate-text"
}
